# ========================
# PYTHON
# ========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Test / coverage
.pytest_cache/
htmlcov/
.coverage

# ========================
# NODE.JS / JAVASCRIPT
# ========================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
.next/
out/

# ========================
# ENVIRONMENT & SECRETS
# ========================

# Environment files — NEVER commit these!
.env
.env.local
.env.*.local
*.env

# Google Cloud / Firebase service account keys
*.json
!package.json
!package-lock.json

